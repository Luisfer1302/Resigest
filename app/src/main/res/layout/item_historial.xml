<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="4dp"
    app:strokeColor="#CFD8DC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistorialTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUIDADO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0B4F8A" />

            <TextView
                android:id="@+id/tvHistorialFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="2026-10-21 00:00"
                android:textSize="11sp"
                android:textColor="#546E7A" />

            <TextView
                android:id="@+id/tvHistorialProfesional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L. Fernando (TCAE)"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="#546E7A" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistorialDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Decúbito Lateral Dcho - Realizado"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>